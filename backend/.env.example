# Copy this file to .env and fill in your values

SECRET_KEY=django-insecure-change-this-in-production

DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE options: sqlite | mysql | postgresql
DB_ENGINE=sqlite

# MySQL / PostgreSQL settings (only needed when DB_ENGINE != sqlite)
DB_NAME=grievancehub
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=3306

# CORS — comma-separated origins for your frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration
# For development, use console backend (prints to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production, use SMTP (e.g., Gmail)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@mgit.ac.in
